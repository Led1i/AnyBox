function(anybox_add_shader_recompiler)
    set(PROJECT_SOURCE_DIR "${CMAKE_SOURCE_DIR}/3rdparty/anyps5")
    set(BUILD_TESTING OFF)
    set(ANYPS5_ENABLE_SPIRV_TOOLS OFF)
    set(ANYPS5_USE_SYSTEM_DEPS OFF)
    set(ANYPS5_SPIRV_HEADERS_SOURCE_DIR "${CMAKE_SOURCE_DIR}/3rdparty/SPIRV-Headers")
    set(ANYPS5_SPIRV_HEADERS_INCLUDE_DIR "${ANYPS5_SPIRV_HEADERS_SOURCE_DIR}/include")
    set(ANYPS5_GLSLANG_SOURCE_DIR "${CMAKE_SOURCE_DIR}/3rdparty/glslang")
    set(ANYPS5_GLSLANG_INCLUDE_DIRS "${ANYPS5_GLSLANG_SOURCE_DIR}")
    include("${PROJECT_SOURCE_DIR}/core/shader/recompiler/CMakeLists.txt")
    add_shader_recompiler(anybox_shader_recompiler anybox_shader_host)
    target_compile_definitions(anybox_shader_recompiler PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
    target_compile_definitions(anybox_shader_recompiler PRIVATE _CRT_SECURE_NO_WARNINGS)
    target_include_directories(anybox_shader_recompiler PRIVATE "${CMAKE_SOURCE_DIR}/core/shader/platform/windows" "${CMAKE_SOURCE_DIR}/core/common/include")
    if(MSVC)
        set_property(TARGET anybox_shader_recompiler PROPERTY COMPILE_OPTIONS "/FI${PROJECT_SOURCE_DIR}/core/libs/prx/libc/include/HostStandardStreams.hpp" /EHsc)
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        set_property(SOURCE "${PROJECT_SOURCE_DIR}/core/shader/recompiler/SpirvBackend/src/SpirvSpecialization.cpp" TARGET_DIRECTORY anybox_shader_recompiler APPEND PROPERTY COMPILE_OPTIONS -Wno-c++11-narrowing)
    endif()
endfunction()
