[submodule "3rdparty/opus"]
	path = 3rdparty/opus
	url = https://github.com/xiph/opus.git
[submodule "3rdparty/libdeflate"]
	path = 3rdparty/libdeflate
	url = https://github.com/ebiggers/libdeflate.git
[submodule "3rdparty/zlib"]
	path = 3rdparty/zlib
	url = https://github.com/madler/zlib.git
[submodule "3rdparty/ffmpeg"]
	path = 3rdparty/ffmpeg
	url = https://github.com/xenia-project/FFmpeg.git
	shallow = true
